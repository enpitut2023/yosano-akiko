{
  "name": "akiko",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "format": "prettier -w .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "npm run lint:eslint && npm run lint:format && npm run lint:grade-csvs",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:grade-csvs": "tsx scripts/lint-grade-csvs.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.9.9",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-istanbul": "^5.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.108.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "lucide-svelte": "^1.0.1",
    "papaparse": "^5.7.0",
    "zod": "^4.3.6"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
